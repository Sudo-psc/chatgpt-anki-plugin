# =============================================================================
# chatgpt-anki-plugin — exemplo de configuração
# Copie para .env e ajuste. NUNCA comite um .env real.
# =============================================================================

# --- Servidor HTTP ---
PORT="8080"
HOST="0.0.0.0"
# URL pública base do servidor (usada em metadados OAuth e no redirect da UI).
# Em produção use o domínio HTTPS, ex.: https://chatgpt-anki-mcp.fly.dev
PUBLIC_BASE_URL="http://localhost:8080"
NODE_ENV="development"
LOG_LEVEL="info"

# --- Backend Anki ---
# connect = AnkiConnect real (Anki Desktop rodando com o add-on) | mock = demo/sintético
ANKI_BACKEND="connect"
ANKI_CONNECT_URL="http://127.0.0.1:8765"
# Chave de API do AnkiConnect (configurável no add-on; recomendado habilitar)
ANKI_CONNECT_API_KEY=""
ANKI_TIMEOUT_MS="10000"

# --- Segurança / OAuth 2.1 ---
# Segredo HMAC para assinatura dos access tokens. Gere com:
#   openssl rand -base64 48
# O servidor RECUSA iniciar em produção com o valor padrão.
TOKEN_SECRET="replace-with-a-random-secret-of-at-least-32-bytes"
TOKEN_TTL_SECONDS="3600"
# Issuer OAuth (default: PUBLIC_BASE_URL)
OAUTH_ISSUER=""
# Client pré-registrado (para conectar manualmente); DCR também habilitado por padrão
OAUTH_CLIENT_ID="chatgpt"
OAUTH_CLIENT_SECRET=""
OAUTH_ALLOW_DCR="true"
# Redirect URIs permitidos (CSV). O connector do ChatGPT usa o primeiro por padrão.
OAUTH_ALLOWED_REDIRECT_URIS="https://chatgpt.com/connector_platform_oauth_redirect,http://localhost:3000/callback"
# Scopes concedidos por padrão no consentimento
DEFAULT_SCOPE="anki:read anki:write anki:review"
# Exigir Bearer token em /mcp (true em produção; false somente em dev local)
AUTH_REQUIRED="true"
# Token estático de desenvolvimento (SOMENTE dev; vazio = desabilitado)
MCP_DEV_TOKEN=""

# --- Limites ---
RATE_LIMIT_PER_MINUTE="120"
MAX_BODY_BYTES="1048576"

# --- CORS/Origin (validação de Origin do transporte MCP) ---
ALLOWED_ORIGINS="https://chatgpt.com,https://chat.openai.com,http://localhost:8080,http://127.0.0.1:8080"
