# Server configuration
NODE_ENV=development
PORT=3000
HOST=127.0.0.1
PUBLIC_BASE_URL=http://127.0.0.1:3000

# Anki backend mode: "ankiconnect" | "bridge" | "memory"
ANKI_BACKEND=ankiconnect
ANKICONNECT_URL=http://127.0.0.1:8765
ANKICONNECT_API_KEY=
ANKICONNECT_TIMEOUT_MS=8000
ANKI_READ_ONLY=0

# OAuth 2.1 / Security configuration
# Generate with: openssl rand -hex 32
OAUTH_JWT_SECRET=replace-with-32-byte-random-hex-secret-in-production
OAUTH_ISSUER=http://127.0.0.1:3000
OAUTH_ACCESS_TOKEN_TTL_SECONDS=3600
# Optional static admin passphrase to approve OAuth authorization screens & pair local bridge
OAUTH_AUTHORIZE_PIN=anki-dev-pin
# Only set to 1 on local loopback for development
MCP_ALLOW_UNAUTHENTICATED=0

# WebSocket relay secret for pairing local `anki-bridge` with remote HTTPS server
BRIDGE_SHARED_TOKEN=
